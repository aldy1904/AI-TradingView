//@version=6
indicator("AI Trading Analyzer V0.3 — Structure Setup", overlay = true, max_lines_count = 12, max_labels_count = 8)

// V0.3 is a visualization-only proof of concept.
// It detects completed-bar market-structure setups. It does not place or execute orders.

groupTrend = "1. Trend filter"
fastEmaLength = input.int(50, "Fast EMA length", minval = 1, group = groupTrend)
slowEmaLength = input.int(200, "Slow EMA length", minval = 2, group = groupTrend)
showEma50 = input.bool(true, "Show EMA 50", group = groupTrend)
showEma200 = input.bool(true, "Show EMA 200", group = groupTrend)
ema50Color = input.color(color.orange, "EMA 50 color", group = groupTrend)
ema200Color = input.color(color.blue, "EMA 200 color", group = groupTrend)

groupStructure = "2. Market structure"
swingLength = input.int(5, "Swing confirmation bars", minval = 1, group = groupStructure)
showSwingMarkers = input.bool(false, "Show confirmed swing markers", group = groupStructure)
showStructureLine = input.bool(true, "Show latest BOS / CHoCH line", group = groupStructure)
structureLabelOffsetAtr = input.float(0.15, "Structure text offset (ATR)", minval = 0.0, step = 0.05, group = groupStructure)
showStructureLabel = input.bool(true, "Show BOS / CHoCH label", group = groupStructure)
structureColor = input.color(color.yellow, "Structure label color", group = groupStructure)

groupRisk = "3. Automatic trade levels"
stopBufferTicks = input.int(10, "Stop buffer (ticks)", minval = 0, group = groupRisk)
minimumRiskTicks = input.int(20, "Minimum risk (ticks)", minval = 1, group = groupRisk)
levelDisplayBars = input.int(18, "Level display length (bars)", minval = 1, group = groupRisk)
showTradeLevels = input.bool(true, "Show latest trade levels", group = groupRisk)
entryColor = input.color(color.white, "Entry color", group = groupRisk)
stopColor = input.color(color.red, "Stop Loss color", group = groupRisk)
tp1Color = input.color(color.lime, "TP1 color", group = groupRisk)
tp2Color = input.color(color.green, "TP2 color", group = groupRisk)

groupLabels = "4. Labels"
showLevelLabels = input.bool(true, "Show Entry / SL / TP labels", group = groupLabels)
labelTextColor = input.color(color.white, "Label text color", group = groupLabels)

ema50 = ta.ema(close, fastEmaLength)
ema200 = ta.ema(close, slowEmaLength)
structureAtr = ta.atr(14)
bullTrend = ema50 > ema200
bearTrend = ema50 < ema200

plot(showEma50 ? ema50 : na, "EMA 50", color = ema50Color, linewidth = 2)
plot(showEma200 ? ema200 : na, "EMA 200", color = ema200Color, linewidth = 2)

pivotHigh = ta.pivothigh(high, swingLength, swingLength)
pivotLow = ta.pivotlow(low, swingLength, swingLength)

var float lastSwingHigh = na
var float lastSwingLow = na
var int lastSwingHighBar = na
var int lastSwingLowBar = na
var int structureBias = 0

if not na(pivotHigh)
    lastSwingHigh := pivotHigh
    lastSwingHighBar := bar_index - swingLength

if not na(pivotLow)
    lastSwingLow := pivotLow
    lastSwingLowBar := bar_index - swingLength

plotshape(showSwingMarkers and not na(pivotHigh), title = "Confirmed swing high (pivot only)", style = shape.triangledown, location = location.abovebar, color = color.red, size = size.tiny, offset = -swingLength)
plotshape(showSwingMarkers and not na(pivotLow), title = "Confirmed swing low (pivot only)", style = shape.triangleup, location = location.belowbar, color = color.lime, size = size.tiny, offset = -swingLength)

confirmedBar = barstate.isconfirmed
bullBreak = confirmedBar and bar_index > 0 and not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
bearBreak = confirmedBar and bar_index > 0 and not na(lastSwingLow) and close < lastSwingLow and close[1] >= lastSwingLow
bullChoch = bullBreak and structureBias == -1
bearChoch = bearBreak and structureBias == 1

if bullBreak
    structureBias := 1
else if bearBreak
    structureBias := -1

stopBuffer = stopBufferTicks * syminfo.mintick
minimumRisk = minimumRiskTicks * syminfo.mintick

bullEntry = lastSwingHigh
bullStop = lastSwingLow - stopBuffer
bullRisk = bullEntry - bullStop
bearEntry = lastSwingLow
bearStop = lastSwingHigh + stopBuffer
bearRisk = bearStop - bearEntry

bullSetup = bullTrend and bullBreak and not na(lastSwingLow) and bullRisk >= minimumRisk
bearSetup = bearTrend and bearBreak and not na(lastSwingHigh) and bearRisk >= minimumRisk
newSetup = bullSetup or bearSetup

var line structureLine = na
var label structureMarker = na
var line entryLine = na
var line stopLine = na
var line tp1Line = na
var line tp2Line = na
var label entryLabel = na
var label stopLabel = na
var label tp1Label = na
var label tp2Label = na

if bullBreak or bearBreak
    if not na(structureLine)
        line.delete(structureLine)
    if not na(structureMarker)
        label.delete(structureMarker)

    brokenLevel = bullBreak ? lastSwingHigh : lastSwingLow
    swingOriginBar = bullBreak ? lastSwingHighBar : lastSwingLowBar
    structureName = bullBreak ? (bullChoch ? "CHoCH" : "BOS") : (bearChoch ? "CHoCH" : "BOS")
    structureY = bullBreak ? brokenLevel + structureAtr * structureLabelOffsetAtr : brokenLevel - structureAtr * structureLabelOffsetAtr

    if showStructureLine
        structureLine := line.new(swingOriginBar, brokenLevel, bar_index, brokenLevel, xloc = xloc.bar_index, color = structureColor, style = line.style_dashed, width = 1)
    if showStructureLabel
        structureMarker := label.new(bar_index, structureY, structureName, style = label.style_none, textcolor = structureColor, size = size.tiny)

if newSetup
    if not na(entryLine)
        line.delete(entryLine)
    if not na(stopLine)
        line.delete(stopLine)
    if not na(tp1Line)
        line.delete(tp1Line)
    if not na(tp2Line)
        line.delete(tp2Line)
    if not na(entryLabel)
        label.delete(entryLabel)
    if not na(stopLabel)
        label.delete(stopLabel)
    if not na(tp1Label)
        label.delete(tp1Label)
    if not na(tp2Label)
        label.delete(tp2Label)

    activeEntry = bullSetup ? bullEntry : bearEntry
    activeStop = bullSetup ? bullStop : bearStop
    activeRisk = bullSetup ? bullRisk : bearRisk
    activeTp1 = bullSetup ? activeEntry + activeRisk * 1.5 : activeEntry - activeRisk * 1.5
    activeTp2 = bullSetup ? activeEntry + activeRisk * 2.0 : activeEntry - activeRisk * 2.0
    setupEndBar = bar_index + levelDisplayBars
    if showTradeLevels
        entryLine := line.new(bar_index, activeEntry, setupEndBar, activeEntry, xloc = xloc.bar_index, color = entryColor, width = 2)
        stopLine := line.new(bar_index, activeStop, setupEndBar, activeStop, xloc = xloc.bar_index, color = stopColor, width = 2)
        tp1Line := line.new(bar_index, activeTp1, setupEndBar, activeTp1, xloc = xloc.bar_index, color = tp1Color, width = 2)
        tp2Line := line.new(bar_index, activeTp2, setupEndBar, activeTp2, xloc = xloc.bar_index, color = tp2Color, width = 2)

    if showLevelLabels
        entryLabel := label.new(setupEndBar, activeEntry, "Entry", style = label.style_none, textcolor = entryColor, size = size.tiny)
        stopLabel := label.new(setupEndBar, activeStop, "SL", style = label.style_none, textcolor = stopColor, size = size.tiny)
        tp1Label := label.new(setupEndBar, activeTp1, "TP1 1:1.5", style = label.style_none, textcolor = tp1Color, size = size.tiny)
        tp2Label := label.new(setupEndBar, activeTp2, "TP2 1:2", style = label.style_none, textcolor = tp2Color, size = size.tiny)

// Setup logic uses confirmed pivots and confirmed-bar closes only.
// No orders, strategy calls, alerts, HTTP requests, or external bridge are implemented.
